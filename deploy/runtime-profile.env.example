# Compact essential-control profile. Copy selected keys into the private runtime.env.
# No credentials, camera selector, network exposure or automatic service start here.
CAMERA_INTENT_PROFILE=compact
CAMERA_AUTOPILOT_TASTE_STORAGE=auto
# Full float32 index chosen automatically when data/taste_index.compact is verified.
# Optional override must point to an immutable, prepared directory:
# CAMERA_AUTOPILOT_TASTE_COMPACT=/absolute/path/taste_index.compact
# Compact intent uses deterministic supported phrases/recipes, not a smaller LLM.
# Vision refinement remains optional and must not be requested if no VLM is provisioned.
# Split runtime on the puck (docs/RUNTIME_SPLIT_2026-09-28.md): camera control, perception and
# heavy jobs as three services sharing this file. Leave unset on the Mac.
# CAMERA_AUTOPILOT_RUNTIME=split
# CAMERA_AUTOPILOT_PERCEPTION_SOCKET=/run/user/1000/camera-autopilot/perception.sock
