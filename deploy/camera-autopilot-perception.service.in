[Unit]
Description=Camera Autopilot compact perception (CLIP taste retrieval and subject floor)
After=network.target
# No start limit: poison jobs are bounded by heavy_jobs.MAX_ATTEMPTS, and a stranded queue
# is worse than a restart every 10 s. A missing memory cap (exit 78) stops for good.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@BACKEND@
EnvironmentFile=@ENVIRONMENT@
# Marks the process as started by this unit: the worker then refuses to run without an enforced
# memory.max (an INVOCATION_ID alone is inherited by every descendant of any systemd service).
Environment=CAMERA_AUTOPILOT_ENFORCE_MEMORY_CAP=1
ExecStart=@PYTHON@ @ENTRY@
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
TimeoutStartSec=120
TimeoutStopSec=15
# The socket directory: $XDG_RUNTIME_DIR/camera-autopilot (mode 0700). Point
# CAMERA_AUTOPILOT_PERCEPTION_SOCKET at a file inside it in the shared runtime.env.
RuntimeDirectory=camera-autopilot
RuntimeDirectoryMode=0700
# Budget: 1.58 GB measured on the Mac (MPS); CPU torch on arm64 is unmeasured.
# MemoryMax needs the memory cgroup enabled and delegated to the user manager;
# role_perception.py exits 78 at start when it is not enforced.
MemoryHigh=2G
MemoryMax=2560M
# Under whole-system pressure the kernel kills this before camera control.
OOMScoreAdjust=500
TasksMax=128
LimitNOFILE=1024
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
